+"""Manufacturer-independent, read-only stock planning."""
+
+from __future__ import annotations
+
+import json
+import math
+from collections import defaultdict
+from dataclasses import dataclass
+from urllib.parse import urlsplit
+
+
+@dataclass(frozen=True)
+class ReorderPolicy:
+    threshold_g: float = 150
+    unopened_min: int = 1
+    order_qty: int = 1
+
+    def __post_init__(self) -> None:
+        if isinstance(self.threshold_g, bool) or not isinstance(self.threshold_g, (int, float)):
+            raise ValueError("threshold_g must be a finite, non-negative number")
+        if not math.isfinite(self.threshold_g) or self.threshold_g < 0:
+            raise ValueError("threshold_g must be a finite, non-negative number")
+        for name, minimum in (("unopened_min", 0), ("order_qty", 1)):
+            value = getattr(self, name)
+            if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
+                raise ValueError(f"{name} must be an integer of at least {minimum}")
+
+    @classmethod
+    def from_dict(cls, value: dict, default: ReorderPolicy | None = None) -> ReorderPolicy:
+        if not isinstance(value, dict) or set(value) - {"threshold_g", "unopened_min", "order_qty"}:
+            raise ValueError("Policy must contain only threshold_g, unopened_min and order_qty")
+        base = default or cls()
+        return cls(**{key: value.get(key, getattr(base, key)) for key in base.__dataclass_fields__})
+
+
+@dataclass(frozen=True)
+class ReorderItem:
+    profile: str
+    filament_id: int
+    remaining_g: float
+    unopened: int
+    order_qty: int
+    unknown_spools: int = 0
+    needs_reorder: bool = True
+
+
+def profile_key(*, vendor: str | None, material: str | None, name: str | None,
+                color: str | None = None, finish: str | None = None) -> str:
+    """Include colour/finish and use JSON to avoid delimiter collisions."""
+    return json.dumps([" ".join((v or "").strip().casefold().split())
+                       for v in (vendor, material, name, color, finish)], ensure_ascii=False)
+
+
+def calculate_reorders(rows: list[dict], defaults: ReorderPolicy,
+                       overrides: dict[str, ReorderPolicy] | None = None,
+                       *, include_sufficient: bool = False) -> list[ReorderItem]:
+    """Aggregate opened grams separately from unopened reserves.
+
+    Unknown weights block automatic ordering. Archived rows and repeated
+    spool IDs never count. A minimum reserve of zero disables ordering.
+    """
+    groups: dict[str, dict] = {}
+    seen: set[int] = set()
+    for row in rows:
+        if row.get("archived", False):
+            continue
+        spool_id = row.get("spool_id")
+        if spool_id is not None:
+            if spool_id in seen:
+                continue
+            seen.add(spool_id)
+        group = groups.setdefault(row["profile"], {"filament_id": row["filament_id"],
+                                  "remaining": 0.0, "unopened": 0, "unknown": 0})
+        remaining = row.get("remaining_g")
+        if remaining is None or not math.isfinite(float(remaining)):
+            group["unknown"] += 1
+        elif row.get("unused", False) and remaining > 0:
+            group["unopened"] += 1
+        else:
+            group["remaining"] += max(float(remaining), 0)
+    result = []
+    for key, group in groups.items():
+        policy = (overrides or {}).get(key, defaults)
+        needs = (group["unknown"] == 0 and group["remaining"] <= policy.threshold_g
+                 and group["unopened"] < policy.unopened_min)
+        if needs or include_sufficient:
+            result.append(ReorderItem(key, group["filament_id"], group["remaining"], group["unopened"],
+                          max(policy.order_qty, policy.unopened_min - group["unopened"]),
+                          group["unknown"], needs))
+    return sorted(result, key=lambda item: item.profile)
+
+
+def shopify_cart_url(base_url: str, variant_ids: list[tuple[str, int]]) -> str | None:
+    """Build a permalink using an HTTPS origin. Never contact the shop."""
+    try:
+        parts = urlsplit(base_url)
+        valid_origin = (parts.scheme == "https" and parts.hostname and not parts.username
+                        and not parts.password and parts.port in (None, 443)
+                        and parts.path in ("", "/") and not parts.query and not parts.fragment)
+    except (ValueError, AttributeError):
+        return None
+    if not valid_origin or not variant_ids:
+        return None
+    quantities: dict[str, int] = defaultdict(int)
+    for variant, qty in variant_ids:
+        if (not isinstance(variant, str) or not variant.isascii() or not variant.isdigit()
+                or int(variant) <= 0 or isinstance(qty, bool) or not isinstance(qty, int) or qty < 1):
+            return None
+        quantities[variant] += qty
+    cart = ",".join(f"{variant}:{qty}" for variant, qty in sorted(quantities.items()))
+    return f"{base_url.rstrip('/')}/cart/{cart}?storefront=true"
+
+
+def validate_reorder_setting(key: str, obj: object) -> None:
+    """Validate before persistence so malformed settings cannot break reads."""
+    if not key.startswith("reorder_"):
+        return
+    if not isinstance(obj, dict):
+        raise ValueError("Reorder settings must be objects")
+    if key == "reorder_defaults":
+        ReorderPolicy.from_dict(obj)
+    elif key == "reorder_profiles":
+        for value in obj.values():
+            ReorderPolicy.from_dict(value)
+    elif key == "reorder_stock":
+        if set(obj) - {"unopened_locations"}:
+            raise ValueError("Unknown stock setting")
+        locations = obj.get("unopened_locations", [])
+        if not isinstance(locations, list) or any(not isinstance(v, str) or not v.strip() for v in locations):
+            raise ValueError("unopened_locations must be a list of non-empty location names")
+    elif key == "reorder_providers":
+        if set(obj) - {"base_url", "variants"}:
+            raise ValueError("Unknown provider setting")
+        base = obj.get("base_url", "")
+        if not isinstance(base, str) or (base and not shopify_cart_url(base, [("1", 1)])):
+            raise ValueError("Shop URL must be an HTTPS origin without path, credentials or query")
+        variants = obj.get("variants", {})
+        if not isinstance(variants, dict):
+            raise ValueError("variants must be an object")
+        for variant in variants.values():
+            if variant and not shopify_cart_url("https://example.com", [(variant, 1)]):
+                raise ValueError("Variant IDs must be positive ASCII numbers stored as strings")
