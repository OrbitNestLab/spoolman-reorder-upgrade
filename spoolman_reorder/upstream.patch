+
+
+def row(grams=0, **extra):
+    return dict(profile="p", filament_id=1, remaining_g=grams, unused=False, **extra)
+
+
+@pytest.mark.parametrize(("grams","expected"),[(0,True),(149,True),(150,True),(151,False)])
+def test_threshold_boundaries(grams,expected):
+    assert bool(calculate_reorders([row(grams)],ReorderPolicy())) is expected
+
+
+def test_threshold_zero_and_overrides():
+    assert calculate_reorders([row(1)],ReorderPolicy(0))==[]
+    assert calculate_reorders([row(0)],ReorderPolicy(0))
+    assert calculate_reorders([row(149)],ReorderPolicy(),{"p":ReorderPolicy(100)})==[]
+    assert ReorderPolicy.from_dict({"threshold_g":0},ReorderPolicy(200,3,4))==ReorderPolicy(0,3,4)
+
+
+@pytest.mark.parametrize("reserves",[0,1,3])
+def test_reserves_and_order_quantities(reserves):
+    rows=[row(0)]+[dict(profile="p",filament_id=1,remaining_g=1000,unused=True) for _ in range(reserves)]
+    plan=calculate_reorders(rows,ReorderPolicy(unopened_min=3,order_qty=2))
+    assert bool(plan)==(reserves<3)
+    if plan: assert plan[0].order_qty==max(2,3-reserves)
+
+
+def test_unknown_archived_duplicate_and_zero_reserve():
+    assert calculate_reorders([row(None)],ReorderPolicy())==[]
+    assert calculate_reorders([row(0,archived=True)],ReorderPolicy())==[]
+    assert calculate_reorders([row(0)],ReorderPolicy(unopened_min=0))==[]
+    item=row(100,spool_id=9)
+    assert calculate_reorders([item,item],ReorderPolicy())[0].remaining_g==100
+
+
+def test_color_finish_and_delimiter_collisions():
+    a=dict(vendor="A",material="PLA",name="Red")
+    assert profile_key(**a,color="a")!=profile_key(**a,color="b")
+    assert profile_key(**a,finish="matte")!=profile_key(**a,finish="silk")
+    assert profile_key(vendor="a|b",material="c",name="")!=profile_key(vendor="a",material="b|c",name="")
+
+
+@pytest.mark.parametrize("origin",["http://shop.test","javascript:alert(1)","https://user:pass@shop.test",
+                                  "https://shop.test/path","https://shop.test?x=1","https://shop.test/#frag"])
+def test_shop_origin_rejections(origin):
+    assert shopify_cart_url(origin,[("123",1)]) is None
+
+
+def test_cart_rollover_empty_and_duplicate_variants():
+    assert shopify_cart_url("https://eu.store.bambulab.com",[("123",2),("123",3)])=="https://eu.store.bambulab.com/cart/123:5?storefront=true"
+    for bad in [[],[("unknown",1)],[("0",1)],[("١٢٣",1)],[("123",0)],[("123",True)]]:
+        assert shopify_cart_url("https://shop.test",bad) is None
+
+
+@pytest.mark.parametrize("value",[{"threshold_g":-1},{"threshold_g":True},{"threshold_g":float("nan")},
+                                  {"order_qty":0},{"unopened_min":1.5},{"unopened_min":True}])
+def test_invalid_settings_rejected(value):
+    with pytest.raises(ValueError): parse_setting("reorder_defaults").validate_type(json.dumps(value))
+
+
