+import { getJson } from './http';
+
+export interface ReorderItem {
+	profile: string;
+	filament_id: number;
+	vendor: string | null;
+	material: string | null;
+	name: string | null;
+	color: string | null;
+	weight: number | null;
+	remaining_g: number;
+	unopened: number;
+	unknown_spools: number;
+	needs_reorder: boolean;
+	threshold_g: number;
+	unopened_min: number;
+	order_qty: number;
+	variant_id: string | null;
+	cart_url: string | null;
+}
+export interface Policy {
+	threshold_g: number;
+	unopened_min: number;
+	order_qty: number;
+}
+export interface CatalogVariant {
+	id: number;
+	title: string;
+	sku: string;
+	available: boolean;
+	option1: string;
+	option2: string;
+	option3: string;
+}
+export interface CatalogProduct {
+	title: string;
+	handle: string;
+	variants: CatalogVariant[];
+}
+export function getReorderPlan(signal?: AbortSignal): Promise<ReorderItem[]> {
+	return getJson('/reorder', { include_sufficient: 'true' }, signal);
+}
+export function getReorderCatalog(signal?: AbortSignal): Promise<CatalogProduct[]> {
+	return getJson('/reorder/catalog', {}, signal);
+}
+export function getReorderCart(): Promise<{ url: string | null; excluded: string[] }> {
+	return getJson('/reorder/cart');
+}
