+"""Read-only reorder planning; policies use the existing settings API and DB."""
+
+import json
+import os
+from dataclasses import asdict
+from pathlib import Path
+from typing import Annotated
+
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+from sqlalchemy.orm import selectinload
+
+from spoolman.database import setting
+from spoolman.database.database import get_db_session
+from spoolman.database.models import Filament, Spool
+from spoolman.exceptions import ItemNotFoundError
+from spoolman.reorder import ReorderPolicy, calculate_reorders, profile_key, shopify_cart_url
+from spoolman.settings import parse_setting
+
+router = APIRouter(prefix="/reorder", tags=["reorder"])
+
+
+class ReorderResponse(BaseModel):
+    profile: str
+    filament_id: int
+    remaining_g: float
+    unopened: int
+    order_qty: int
+    unknown_spools: int
+    needs_reorder: bool
+    vendor: str | None
+    material: str | None
+    name: str | None
+    color: str | None
+    weight: float | None
+    threshold_g: float
+    unopened_min: int
+    variant_id: str | None = None
+    cart_url: str | None = None
+
+
+async def _setting_value(db: AsyncSession, key: str) -> dict:
+    definition = parse_setting(key)
+    try:
+        raw = (await setting.get(db, definition)).value
+    except ItemNotFoundError:
+        raw = definition.default
+    return json.loads(raw)
+
+
+@router.get("/catalog", summary="Get the optional provider catalog")
+@router.get("/bambu-catalog", include_in_schema=False)
+async def catalog() -> list[dict]:
+    """The HA package opts in with a file; the generic core has no vendor data."""
+    path = os.environ.get("SPOOLMAN_REORDER_CATALOG")
+    if not path:
+        return []
+    try:
+        return json.loads(Path(path).read_text(encoding="utf-8"))
+    except (OSError, ValueError) as exc:
+        raise HTTPException(503, "Optional provider catalog is unavailable") from exc
+
+
+@router.get("", response_model=list[ReorderResponse])
+async def find(db: Annotated[AsyncSession, Depends(get_db_session)],
+               include_sufficient: bool = False) -> list[ReorderResponse]:
+    """Only read inventory; unknown weight never triggers a suggestion."""
+    try:
+        defaults = ReorderPolicy.from_dict(await _setting_value(db, "reorder_defaults"))
+        raw_profiles = await _setting_value(db, "reorder_profiles")
+        policies = {key: ReorderPolicy.from_dict(value, defaults) for key, value in raw_profiles.items()}
+        provider = await _setting_value(db, "reorder_providers")
+        stock = await _setting_value(db, "reorder_stock")
+    except (ValueError, TypeError, AttributeError) as exc:
+        raise HTTPException(422, "Invalid reorder settings; reset them in Settings") from exc
+    reserve_locations = set(stock.get("unopened_locations", []))
+    result = await db.execute(select(Spool).where(Spool.archived.is_not(True)).options(
+        selectinload(Spool.filament).selectinload(Filament.vendor)))
+    rows, metadata = [], {}
+    for spool in result.scalars().all():
+        f = spool.filament
+        vendor = f.vendor.name if f.vendor else None
+        color = f.multi_color_hexes or f.color_hex
+        key = profile_key(vendor=vendor, material=f.material, name=f.name, color=color,
+                          finish=f.multi_color_direction)
+        if not f.name and not color:
+            key += f":{f.id}"
+        initial = spool.initial_weight if spool.initial_weight is not None else f.weight
+        remaining = max(initial - spool.used_weight, 0) if initial is not None else None
+        unused = (remaining is not None and remaining > 0 and spool.used_weight == 0
+                  and (spool.location in reserve_locations
+                       or (spool.first_used is None and spool.last_used is None)))
+        metadata[key] = dict(vendor=vendor, material=f.material, name=f.name, color=color, weight=f.weight)
+        rows.append(dict(profile=key, spool_id=spool.id, filament_id=f.id, remaining_g=remaining, unused=unused))
+    response = []
+    for item in calculate_reorders(rows, defaults, policies, include_sufficient=include_sufficient):
+        policy = policies.get(item.profile, defaults)
+        variant = provider.get("variants", {}).get(item.profile) or None
+        url = shopify_cart_url(provider.get("base_url", ""), [(variant, item.order_qty)]) if variant else None
+        response.append(ReorderResponse(**asdict(item), **metadata[item.profile], threshold_g=policy.threshold_g,
+                        unopened_min=policy.unopened_min, variant_id=variant if url else None, cart_url=url))
+    return response
+
+
+@router.get("/cart")
+async def cart(db: Annotated[AsyncSession, Depends(get_db_session)]) -> dict:
+    """Aggregate repeated variant IDs into one permalink and list unmapped rows."""
+    items = await find(db, include_sufficient=False)
+    provider = await _setting_value(db, "reorder_providers")
+    mapped = [(item.variant_id, item.order_qty) for item in items if item.cart_url and item.variant_id]
+    return {"url": shopify_cart_url(provider.get("base_url", ""), mapped),
+            "excluded": [item.profile for item in items if not item.cart_url]}
